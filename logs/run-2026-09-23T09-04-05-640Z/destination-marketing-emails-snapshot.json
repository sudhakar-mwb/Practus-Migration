            "footer_html": "<p style=\"text-align: center; font-size: 12px; line-height: 125%; font-family: 'Roboto', Arial, sans-serif;\"><span style=\"color: #ffffff;\"> To ensure you keep receiving these emails, please add <a href=\"mailto:hello@touchmath.com\" style=\"color: #ffffff;\" rel=\"noopener\">hello@touchmath.com</a> to your address book. Please note, hello@touchmath.com is not a monitored inbox. To reach a member of our team, please send an email to <a href=\"mailto:customerservice@touchmath.com\" style=\"color: #ffffff;\" rel=\"noopener\">customerservice@touchmath.com</a> or call us at 1-800-888-9191. </span></p>\n<p style=\"text-align: center; font-size: 12px; line-height: 125%; font-family: 'Roboto', Arial, sans-serif;\">&nbsp;</p>\n<p style=\"text-align: center; font-size: 12px; line-height: 125%; font-family: 'Roboto', Arial, sans-serif;\"><span style=\"color: #ffffff;\"> Want out of the loop? <a href=\"{{ unsubscribe_link_all }}\" style=\"color: #ffffff;\" data-unsubscribe=\"true\">Unsubscribe</a> or <a href=\"{{ unsubscribe_link }}\" style=\"color: #ffffff;\" data-unsubscribe=\"true\">Manage Preferences</a> </span></p>\n<p style=\"text-align: center; font-size: 12px; line-height: 125%; font-family: 'Roboto', Arial, sans-serif;\">&nbsp;</p>\n<p style=\"text-align: center; font-size: 12px; line-height: 125%; font-family: 'Roboto', Arial, sans-serif;\"><span style=\"color: #ffffff;\"> Our postal address: {{ site_settings.company_name }}, {{ site_settings.company_street_address_1 }}, {{ site_settings.company_street_address_2 }}, {{ site_settings.company_city }}, {{ site_settings.company_state }}, {{ site_settings.company_zip }} </span></p>",
